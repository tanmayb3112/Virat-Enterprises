# Virat Enterprises — environment variables.
# Copy to .env.local for local dev, or set these in Vercel Project Settings.
# The site runs fully WITHOUT any of these (demo mode: orders/leads fall back to
# WhatsApp + manual UPI). Add them to progressively enable the backend.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://virat-enterprises.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=919823141366        # shop WhatsApp, country code, no +

# --- Supabase (enables persistence, admin, order tracking) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                        # server-only, never expose

# --- Payments ---
NEXT_PUBLIC_PAYMENT_MODE=manual                   # manual | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
# Also sends LOGIN CODES: with this key set (plus SUPABASE_SERVICE_ROLE_KEY) the
# site emails its own 6-digit login codes and never touches Supabase's SMTP.
RESEND_API_KEY=
RESEND_FROM=                                      # e.g. "Virat Orders <orders@yourdomain.in>"; default uses resend.dev sandbox
ADMIN_EMAILS=tanmay.bhanushali@photonlegal.com    # comma-separated

# --- Admin settings page (interim guard until Supabase Auth logins) ---
ADMIN_PASSCODE=                                   # required to save /admin/settings when Supabase is live

# --- Maps / delivery distance ---
# Server-side ONLY (never NEXT_PUBLIC_): a public key is readable in the browser
# and billable by anyone who finds it. Without this, /api/geocode reports
# not_configured and the wizard says the shop will confirm the delivery charge
# instead of promising free delivery. Enable "Geocoding API" on the key.
GOOGLE_MAPS_API_KEY=

# --- Analytics / ads ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Tax ---
NEXT_PUBLIC_GST_ENABLED=false
GST_NUMBER=

# --- Delivery rule (optional overrides of the defaults 3km / ₹500) ---
NEXT_PUBLIC_FREE_DELIVERY_RADIUS_KM=3
NEXT_PUBLIC_FREE_DELIVERY_MIN_ORDER=500
