# Virat Enterprises — environment variables.
# Copy to .env.local for local dev, or set these in Vercel Project Settings.
# The site runs fully WITHOUT any of these (demo mode: orders/leads fall back to
# WhatsApp + manual UPI). Add them to progressively enable the backend.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://virat-enterprises.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=919823141366        # shop WhatsApp, country code, no +

# --- Supabase (enables persistence, admin, order tracking) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                        # server-only, never expose

# --- Payments ---
NEXT_PUBLIC_PAYMENT_MODE=manual                   # manual | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
ADMIN_EMAILS=tanmay.bhanushali@photonlegal.com    # comma-separated

# --- Analytics / ads ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Tax ---
NEXT_PUBLIC_GST_ENABLED=false
GST_NUMBER=

# --- Delivery rule (optional overrides of the defaults 3km / ₹500) ---
NEXT_PUBLIC_FREE_DELIVERY_RADIUS_KM=3
NEXT_PUBLIC_FREE_DELIVERY_MIN_ORDER=500
